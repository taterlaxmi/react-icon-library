{
    "name": "@taterlaxmi/react-icon-library",
    "version": "1.0.4",
    "publishConfig": {
        "access": "public"
    },
    "description": "Generate reusable React icon components from image assets.",
    "license": "MIT",
    "author": "React Icon Library contributors",
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./generator": {
            "types": "./dist/generator.d.ts",
            "import": "./dist/generator.js",
            "require": "./dist/generator.cjs"
        }
    },
    "bin": {
        "react-icon-library": "./dist/cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup src/index.ts src/generator.ts src/cli.ts --format esm,cjs --dts --clean --splitting false",
        "dev": "node ./dist/cli.js ./brand-assets --output ./src/icons --overwrite",
        "generate": "node ./dist/cli.js",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test test/*.test.*",
        "prepublishOnly": "npm run build && npm run typecheck && npm test"
    },
    "dependencies": {
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@svgr/plugin-svgo": "^8.1.0",
        "commander": "^13.1.0",
        "image-size": "^2.0.2"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/react": "^19.0.10",
        "react": "^19.0.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/taterlaxmi/react-icon-library.git"
    },
    "bugs": {
        "url": "https://github.com/taterlaxmi/react-icon-library/issues"
    },
    "homepage": "https://github.com/taterlaxmi/react-icon-library#readme"
}
